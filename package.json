{
  "name": "java-impact-flow",
  "displayName": "Java Impact Flow",
  "description": "Visualize Java field, method, callback, API-flow impact, and suggested tests in VS Code.",
  "version": "0.1.4",
  "publisher": "vndkubi",
  "type": "module",
  "main": "./dist/extension.js",
  "bin": {
    "java-impact-flow": "./dist/cli.js",
    "ext-graph": "./dist/cli.js"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20.0.0"
  },
  "icon": "assets/icon.png",
  "categories": [
    "Programming Languages",
    "Visualization",
    "Testing"
  ],
  "scripts": {
    "vscode:prepublish": "npm run build",
    "prepack": "npm run build",
    "build": "tsc -p .",
    "lint": "tsc --noEmit -p .",
    "demo": "node dist/cli.js",
    "smoke:vsix": "npm run build --silent && node dist/vsixSmokeTest.js",
    "release:verify": "npm run lint && npm run test -- --reporter=dot && npm run build && npm run validate:sample && npm run benchmark:performance && npx --yes @vscode/vsce package && npm run smoke:vsix",
    "release:check": "node dist/cli.js release check",
    "release:check:json": "node dist/cli.js release check --json",
    "release:check:ci": "node dist/cli.js release ci --json",
    "release:publish": "npm run release:verify && node dist/cli.js release publish",
    "release:publish:dry-run": "npm run release:verify && node dist/cli.js release publish --dry-run --smoke --json",
    "release:publish:json": "npm run release:verify && node dist/cli.js release publish --json",
    "validate:sample": "node dist/cli.js validate --suite validation/java-impact-flow.validation.json --out outputs/validation-report.json --markdown-out outputs/validation-report.md",
    "benchmark:performance": "node dist/cli.js benchmark performance --root validation/fixtures/spring-orders --target OrderService.findOrders --mode patch-impact --cold-ms 500 --warm-ms 100 --min-trust-score 50 --max-unresolved-calls 2 --min-endpoints 1 --min-suggested-tests 1 --out outputs/performance-report.json",
    "test": "vitest run"
  },
  "activationEvents": [
    "onLanguage:java",
    "onView:javaImpactFlowWorkbench",
    "onCommand:extGraph.showImpactGraph",
    "onCommand:extGraph.exportImpactGraph",
    "onCommand:extGraph.analyzeCurrentChanges",
    "onCommand:extGraph.staticDebugEndpoint",
    "onCommand:extGraph.checkPatchRisk",
    "onCommand:extGraph.refreshWorkbench",
    "onCommand:extGraph.copyWorkbenchPrSummary",
    "onCommand:extGraph.runWorkbenchTopTests",
    "onCommand:extGraph.openWorkbenchRiskReport"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "javaImpactFlow",
          "title": "Java Impact Flow",
          "icon": "assets/icon.png"
        }
      ]
    },
    "views": {
      "javaImpactFlow": [
        {
          "id": "javaImpactFlowWorkbench",
          "name": "Patch Risk Workbench",
          "contextualTitle": "Java Impact Flow"
        }
      ]
    },
    "commands": [
      {
        "command": "extGraph.showImpactGraph",
        "title": "Java Impact Flow: Show Impact View",
        "category": "Java Impact Flow"
      },
      {
        "command": "extGraph.analyzeCurrentChanges",
        "title": "Java Impact Flow: Analyze Current Changes",
        "category": "Java Impact Flow"
      },
      {
        "command": "extGraph.staticDebugEndpoint",
        "title": "Java Impact Flow: Static Debug Endpoint",
        "category": "Java Impact Flow"
      },
      {
        "command": "extGraph.checkPatchRisk",
        "title": "Java Impact Flow: Check Patch Risk",
        "category": "Java Impact Flow"
      },
      {
        "command": "extGraph.exportImpactGraph",
        "title": "Java Impact Flow: Export Impact Report",
        "category": "Java Impact Flow"
      },
      {
        "command": "extGraph.refreshWorkbench",
        "title": "Java Impact Flow: Refresh Workbench",
        "category": "Java Impact Flow",
        "icon": "$(refresh)"
      },
      {
        "command": "extGraph.copyWorkbenchPrSummary",
        "title": "Java Impact Flow: Copy Workbench PR Summary",
        "category": "Java Impact Flow",
        "icon": "$(copy)"
      },
      {
        "command": "extGraph.runWorkbenchTopTests",
        "title": "Java Impact Flow: Run Workbench Top Tests",
        "category": "Java Impact Flow",
        "icon": "$(run)"
      },
      {
        "command": "extGraph.openWorkbenchRiskReport",
        "title": "Java Impact Flow: Open Workbench Risk Report",
        "category": "Java Impact Flow",
        "icon": "$(preview)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "extGraph.analyzeCurrentChanges",
          "when": "resourceLangId == java",
          "group": "navigation@29"
        },
        {
          "command": "extGraph.staticDebugEndpoint",
          "when": "resourceLangId == java",
          "group": "navigation@30"
        },
        {
          "command": "extGraph.checkPatchRisk",
          "when": "resourceLangId == java",
          "group": "navigation@31"
        },
        {
          "command": "extGraph.showImpactGraph",
          "when": "resourceLangId == java",
          "group": "navigation@32"
        },
        {
          "command": "extGraph.exportImpactGraph",
          "when": "resourceLangId == java",
          "group": "navigation@33"
        }
      ],
      "view/title": [
        {
          "command": "extGraph.refreshWorkbench",
          "when": "view == javaImpactFlowWorkbench",
          "group": "navigation@1"
        },
        {
          "command": "extGraph.openWorkbenchRiskReport",
          "when": "view == javaImpactFlowWorkbench",
          "group": "navigation@2"
        },
        {
          "command": "extGraph.copyWorkbenchPrSummary",
          "when": "view == javaImpactFlowWorkbench",
          "group": "navigation@3"
        },
        {
          "command": "extGraph.runWorkbenchTopTests",
          "when": "view == javaImpactFlowWorkbench",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "Java Impact Flow",
      "properties": {
        "extGraph.maxFiles": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Maximum Java files scanned by the static fallback graph builder. Use 0 for full project scan up to the 100000-file safety cap."
        },
        "extGraph.maxFileBytes": {
          "type": "number",
          "default": 300000,
          "minimum": 1000,
          "description": "Maximum bytes read from a single Java file."
        },
        "extGraph.includeTests": {
          "type": "boolean",
          "default": true,
          "description": "Include Java test files as impact graph evidence."
        },
        "extGraph.maxDepth": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Maximum recursive method/callback depth for endpoint flow traces. Use 0 for full depth up to the 20-level safety cap."
        },
        "extGraph.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show inline Java Impact Flow CodeLens entries on Java classes and methods."
        },
        "extGraph.codeLensMaxSymbols": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "maximum": 20,
          "description": "Maximum Java classes or methods per file that receive impact-count CodeLens entries."
        }
      }
    }
  },
  "keywords": [
    "vscode",
    "java",
    "api-flow",
    "suggested-tests",
    "impact-graph",
    "blast-radius",
    "call-hierarchy",
    "references"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/vndkubi/java-impact-flow.git"
  },
  "bugs": {
    "url": "https://github.com/vndkubi/java-impact-flow/issues"
  },
  "homepage": "https://github.com/vndkubi/java-impact-flow#readme",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
